# Build time (Docker --build-arg, or env for `pnpm build`). Public values.
SITE_URL=https://xekey.app
CONTACT_EMAIL=hello@xekey.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Runtime secrets (Dokploy env). Never build args, never in client code.
DATABASE_URL=postgres://user:password@host:5432/xekey
TURNSTILE_SECRET_KEY=
SIGNING_SECRET=
ADMIN_TOKEN=

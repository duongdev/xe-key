{
  "expo": {
    "name": "Xe Key",
    "slug": "xe-key",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.duongdev.xekey"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F4F4F6",
          "dark": {
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-router",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "xekey"
  }
}

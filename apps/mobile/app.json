{
  "expo": {
    "name": "Xe Key",
    "slug": "xe-key",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.duongdev.xekey",
      "appleTeamId": "9F77J83SKT"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xe Key uses your location to show how far away your car is."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 104,
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-router",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "xekey"
  }
}

meta {
  name: finder ping
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/car/finder/location
  body: json
  auth: none
}

headers {
  app: OneApp
  User-Agent: HConnect-OneApp
  Cookie: {{cookie}}
}

body:json {
{
  "carOid": "{{carOid}}",
  "clientUUID": "{{clientUUID}}"
}
}

docs {
  WARNING: Pings the car for its live location. This sends a real command to the vehicle.
}

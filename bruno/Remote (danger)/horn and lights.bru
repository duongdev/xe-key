meta {
  name: horn and lights
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/remote/hornLight
  body: formUrlEncoded
  auth: none
}

headers {
  app: OneApp
  User-Agent: HConnect-OneApp
  Cookie: {{cookie}}
}

body:form-urlencoded {
  carOid: {{carOid}}
  clientUUID: {{clientUUID}}
  command: horn-lights
}

docs {
  WARNING: Honks the horn and flashes the lights. This sends a real command to the vehicle.
}

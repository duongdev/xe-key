meta {
  name: unlock
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/remote/doorLock
  body: formUrlEncoded
  auth: none
}

headers {
  app: OneApp
  User-Agent: HConnect-OneApp
  Cookie: {{cookie}}
}

body:form-urlencoded {
  carOid: {{carOid}}
  clientUUID: {{clientUUID}}
  command: doorUnlock
}

docs {
  WARNING: UNLOCKS the car. This sends a real command to the vehicle.
}

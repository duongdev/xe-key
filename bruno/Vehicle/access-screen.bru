meta {
  name: access-screen
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/car/access-screen
  body: formUrlEncoded
  auth: none
}

headers {
  app: OneApp
  User-Agent: HConnect-OneApp
  Cookie: {{cookie}}
}

body:form-urlencoded {
  apiName: remote/engine
  status: 2
}

docs {
  WARNING: Access/audit log call. Not a wake call. This sends a real command to the vehicle.
}
